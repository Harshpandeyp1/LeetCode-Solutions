/**
 * PROBLEM: LeetCode 75 - Sort Colors
 * 
 * Given an array 'nums' with n objects colored red (0), white (1), or blue (2), 
 * sort them in-place so that objects of the same color are adjacent.
 * 
 * APPROACH: Dutch National Flag Algorithm (3 Pointers)
 * ---------------------------------------------------
 * - 'low' marks the boundary for 0s.
 * - 'mid' scans the array from left to right.
 * - 'high' marks the boundary for 2s.
 * 
 * Rules during scan at nums[mid]:
 * 1. If nums[mid] == 0: swap(low, mid), low++, mid++
 * 2. If nums[mid] == 1: mid++ (already in middle region)
 * 3. If nums[mid] == 2: swap(mid, high), high-- (do NOT increment mid yet!)
 * 
 * TIME COMPLEXITY:  O(N) - Single pass through the array.
 * SPACE COMPLEXITY: O(1) - Auxiliary space.
 */
class Solution {
    public void sortColors(int[] nums) {
        int low = 0;
        int mid = 0;
        int high = nums.length - 1;

        while (mid <= high) {
            if (nums[mid] == 0) {
                swap(nums, low, mid);
                low++;
                mid++;
            } else if (nums[mid] == 1) {
                mid++;
            } else { // nums[mid] == 2
                swap(nums, mid, high);
                high--; // Note: mid is NOT incremented because swapped element needs evaluation!
            }
        }
    }

    private void swap(int[] nums, int i, int j) {
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }
}
